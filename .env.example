# Copy to .env (chmod 600) and fill in. Never commit the real .env.
TG_BOT_TOKEN=
TG_CHAT_ID=@your_channel_or_-100id
NEWSBOT_STATE=data/state.json
NEWSBOT_ADDR=127.0.0.1:8080

# Binance API key with read permission only — the announcements WebSocket, the only way announcements arrive
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional (defaults shown)
# NEWSBOT_JOURNAL=data/journal.jsonl   # JSONL of every seen event and error
# NEWSBOT_CHART_DIR=                   # dry run: save chart PNGs here
# NEWSBOT_DISABLE=                     # what to skip by name: a source of the feed or of the calendar, `pulse` (the live
                                       #   pulse) or `watchlist` (the scan), e.g. stablecoin-depeg,market-reminders,pulse,watchlist
# DRY_RUN=0                            # 1 = print to stdout instead of Telegram
# ANNOUNCEMENT_MAX_AGE_MINUTES=10      # older Binance announcements are skipped
# HACK_MIN_USD=5000000
# DEPEG_THRESHOLD=0.01
# BINANCE_TESTNET_KEY=                 # testnet.binancefuture.com key: the desk trades test money there; without it the desk is idle
# BINANCE_TESTNET_SECRET=
# NEWSBOT_WATCHLIST=data/watchlist.json # the owner's watchlist
# NEWSBOT_AGENT_LOG=data/agents.jsonl  # every question to an agent: its tool calls, findings and answer
# NEWSBOT_WATCHES=data/watches.json    # the plans the owner set to be watched, and what became of them
# NEWSBOT_EVENTS=data/events.json      # the last 200 events of the feed, shown again after a restart
# PULSE_INTEREST_SHIFT=0.02            # a contract "woke up" in the pulse when its open interest changed by this fraction in five minutes…
# PULSE_LONGS_SHIFT=0.02               # …while the share of long accounts shifted by this much over the quarter of an hour (0.02 = 2 points)
# PULSE_LAUNCH_TIMES=10                # a contract "launched from quiet" when an hourly candle is this many usual hours of the two quiet days before it…
# PULSE_LAUNCH_MOVE=0.05                # …and rose by at least this fraction, on five times the usual volume
# PLAN_WATCH_DAYS=7                    # how long a plan is watched before it lapses
# REMINDER_LEAD_MINUTES=10            # how long before a timed calendar event the feed reminds of it
# NEWSBOT_AUTO=data/auto.json          # the auto-trading switch and the events it already planned
# NEWSBOT_READS=data/reads.json        # what the unlock table last gave and when, so a restart does not run its script again
# NEWSBOT_UNLOCKS_SCRIPT=              # the owner's script that prints a CSV table of coming unlocks; run once a day when set
# NEWSBOT_PYTHON=python3               # the interpreter that script is run with
# NEWSBOT_RESEARCH=data/research.json  # the news found about coins and the risk manager's last plans for each
# NEWSBOT_SCAN=data/scan.json          # the last scan of every coin, shown at once after a restart

# The market's general calendar: Fed meetings and the main US statistics need no key
# FINNHUB_KEY=                         # a free Finnhub API key: adds the earnings dates of the tracked US equities to the calendar
# FRED_KEY=                            # a free FRED API key: adds the days of CPI, PPI and the jobs report to the calendar

# The agents' model: an OpenAI-compatible API
MODEL_KEY=                             # the key of any OpenAI-compatible API with tool calls
# MODEL_URL=https://opencode.ai/zen/go/v1
# MODEL_NAME=deepseek-v4.1-flash
# TAVILY_KEY=                          # a Tavily API key: gives the researcher `web_search`
# OSINTER_SEARCHES_PER_QUESTION=3      # paid web searches one question to the researcher may spend; no other agent has them
# FUNNEL_FINALISTS=3                   # how many coins the search for candidates studies to the bottom
# AGENT_MEMORY_EXCHANGES=5             # how many past questions with their answers the analyst, the researcher and the trader see
# PAGES_PER_QUESTION=25                # how many pages one question to the researcher may read
# X_BEARER_TOKEN=                      # an X API bearer token: gives the researcher `x_posts`, read only when asked
# X_READS_PER_QUESTION=1               # how many paid reads of X, ten posts each, one question may spend
# NEWSBOT_ACCOUNT=data/account.json    # the desk's positions; the balance itself is read from the exchange
# ACCOUNT_CAPITAL=                     # the desk's working capital, $: sizes and limits count from it and the exchange's
                                       #   balance only moves it; unset — the whole balance. Set it to the account you will trade for real
